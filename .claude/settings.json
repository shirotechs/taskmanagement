{
  "env": {
    "BACKEND_PORT": "8080",
    "FRONTEND_PORT": "5173",
    "MYSQL_PORT": "3306"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin *)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git checkout -b *)",
      "Bash(npm install)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(./gradlew bootRun)",
      "Bash(npm run dev)",
      "Bash(docker compose up -d)",
      "Bash(lsof -ti:*)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -f:*)",
      "Bash(rm *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- *)",
      "Bash(npm uninstall:*)",
      "Bash(pip uninstall:*)",
      "Bash(DROP TABLE:*)",
      "Bash(DELETE FROM:*)"
    ]
  }
}
